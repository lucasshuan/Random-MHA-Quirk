# ── Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ── OpenAI (recommended: gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini (recommended: gemini-2.0-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── LLM Settings
FUSION_PROVIDER=openai # LLM Provider: openai | gemini | auto 
FUSION_TEMPERATURE=0.9 # Creativity (0–1)

# ── Research (sync PT via MyMemory)
SYNC_PT_DELAY_MS=1200
