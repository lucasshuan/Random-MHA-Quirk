# ── Supabase (fusion cache) ─────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Fusão LLM ───────────────────────────────────────────────────────────────
# Copie para .env.local e preencha pelo menos UMA chave de API.

# openai | gemini | auto  (recomendado: openai se você só tem chave OpenAI)
FUSION_PROVIDER=openai

# OpenAI — recomendado (gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini — alternativa barata
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Criatividade (0–1)
FUSION_TEMPERATURE=0.9

# ── Research (sync PT via MyMemory) ─────────────────────────────────────────
SYNC_PT_DELAY_MS=1200
