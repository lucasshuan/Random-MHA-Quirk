# ── Site / API security
# Comma-separated browser origins allowed to call /api (production URL required).
# ALLOWED_ORIGINS=https://your-domain.vercel.app
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
# Catalog API: max requests per IP per window (default 90 / 60s)
# RATE_LIMIT_API_MAX=90
# RATE_LIMIT_API_WINDOW_MS=60000
# Fusion generate: strict — default 15 requests per 5 minutes per IP (disabled in pnpm dev)
# RATE_LIMIT_FUSION_MAX=15
# RATE_LIMIT_FORCE=1
# RATE_LIMIT_FUSION_WINDOW_MS=300000

# ── Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ── OpenAI (fusion agents default: gpt-4.1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ── Google Gemini (recommended: gemini-2.0-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── LLM Settings
FUSION_PROVIDER=openai # Fusion generation: openai only (Agents SDK)
# FUSION_TEMPERATURE / FUSION_TRANSLATION_TEMPERATURE — used by agent model settings where supported
# OpenAI gpt-5/o-series use reasoning_effort instead of temperature (defaults: low / minimal)
# FUSION_REASONING_EFFORT=low
# FUSION_TRANSLATION_REASONING_EFFORT=minimal
# FUSION_MAX_COMPLETION_TOKENS=4096 # gpt-5/o-series output cap (includes hidden reasoning)
# FUSION_MAX_TOKENS=2048 # gpt-4o-mini output cap

# ── Fusion agent (OpenAI Agents SDK)
# FUSION_AGENT_WEB_SEARCH=1 # English agent: search fandom + Wikipedia (default on)
# FUSION_AGENT_WEB_SEARCH_DOMAINS=myheroacademia.fandom.com,en.wikipedia.org
# FUSION_AGENT_MAX_TURNS=5 # Allow search + JSON output (default 5 when web search on)
# Traces: https://platform.openai.com/traces (enabled by default on the server)
# OPENAI_AGENTS_DISABLE_TRACING=1 # SDK-wide off
# FUSION_AGENT_TRACING_DISABLED=1 # Fusion-only off
# FUSION_AGENT_TRACE_SENSITIVE_DATA=1 # Log prompt/tool I/O in traces (default: on in dev, off in prod)
# FUSION_TRACE_EXPORT_API_KEY= # Optional separate key for trace export (defaults to OPENAI_API_KEY)

# ── Research (sync PT via MyMemory)
SYNC_PT_DELAY_MS=1200
