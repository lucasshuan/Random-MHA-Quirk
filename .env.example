# ── Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ── OpenAI (recommended: gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini (recommended: gemini-2.0-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── LLM Settings
FUSION_PROVIDER=openai # LLM Provider: openai | gemini | auto
FUSION_TEMPERATURE=0.9 # gpt-4o-mini / Gemini fusion creativity (0–1)
FUSION_TRANSLATION_TEMPERATURE=0.5 # gpt-4o-mini / Gemini translation fidelity (0–1)
# OpenAI gpt-5/o-series use reasoning_effort instead of temperature (defaults: low / minimal)
# FUSION_REASONING_EFFORT=low
# FUSION_TRANSLATION_REASONING_EFFORT=minimal
# FUSION_MAX_COMPLETION_TOKENS=4096 # gpt-5/o-series output cap (includes hidden reasoning)
# FUSION_MAX_TOKENS=2048 # gpt-4o-mini output cap

# ── Research (sync PT via MyMemory)
SYNC_PT_DELAY_MS=1200
